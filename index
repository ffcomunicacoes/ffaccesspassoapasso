function clone(v){return JSON.parse(JSON.stringify(v))}
const DEFAULT={admin:{user:'admin',pass:'admin123'},features:clone(SEED_FEATURES),tutorials:clone(SEED_TUTORIALS),condos:{'Showroom F&F Comunicações':{},'Paraíso dos Lagos':{}}};
Object.keys(SEED_FEATURES).forEach(k=>{DEFAULT.condos['Showroom F&F Comunicações'][k]=true;DEFAULT.condos['Paraíso dos Lagos'][k]=!['cadastrar','chave','prestadores'].includes(k)});
function migrate(s){if(!s)return clone(DEFAULT);s.admin=s.admin||clone(DEFAULT.admin);s.features=s.features||clone(SEED_FEATURES);s.tutorials=s.tutorials||clone(SEED_TUTORIALS);s.condos=s.condos||clone(DEFAULT.condos);for(const c of Object.keys(s.condos))for(const k of Object.keys(s.features))if(typeof s.condos[c][k]!=='boolean')s.condos[c][k]=true;return s}
let state=migrate((()=>{try{return JSON.parse(localStorage.getItem('ffhelp_v3'))}catch{return null}})());
let currentTutorial=null,stepIndex=0,editKey=null,editStep=0,drawing=false,drawStart=null;
const $=id=>document.getElementById(id);
function persist(){try{localStorage.setItem('ffhelp_v3',JSON.stringify(state))}catch(e){toast('O navegador ficou sem espaço para salvar imagens. Use prints menores.') }}
function toast(t){$('toast').textContent=t;$('toast').classList.add('show');setTimeout(()=>$('toast').classList.remove('show'),2200)}
function condo(){return $('condoSelect').value||Object.keys(state.condos)[0]}
function enabled(k,c=condo()){return !!state.condos[c]?.[k]}
function renderCondoSelects(){for(const id of ['condoSelect','adminCondo']){const el=$(id),old=el.value;el.innerHTML=Object.keys(state.condos).map(n=>`<option>${esc(n)}</option>`).join('');if(state.condos[old])el.value=old}$('condoPill').textContent=condo()}
function esc(s=''){return String(s).replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[m]))}
function renderTopics(){let n=0;$('topicGrid').innerHTML=Object.entries(state.features).filter(([k])=>enabled(k)).map(([k,f])=>{n++;return `<button class="topic" data-key="${esc(k)}"><div class="ico">${esc(f.icon)}</div><b>${esc(f.label)}</b><span>${esc(f.desc)}</span></button>`}).join('');$('enabledCount').textContent=`${n} opções`;$('condoPill').textContent=condo();document.querySelectorAll('.topic').forEach(b=>b.onclick=()=>startTutorial(b.dataset.key))}
function startTutorial(k){if(!enabled(k)||!state.tutorials[k])return toast('Este tutorial não está disponível para este condomínio.');currentTutorial=k;stepIndex=0;renderStep();$('viewer').scrollIntoView({behavior:'smooth',block:'start'})}
function clampPct(v,fallback=0){const n=Number(v);return Number.isFinite(n)?Math.max(0,Math.min(100,n)):fallback}
function showPublicEmpty(msg){$('stepImage').hidden=true;$('spot').hidden=true;$('publicEmpty').textContent=msg||'Escolha um tutorial para ver o passo a passo ilustrado.';$('publicEmpty').hidden=false}
function placePublicSpot(s){const sp=$('spot');if(!s||s.highlight===false||!s.img){sp.hidden=true;return}const x=clampPct(s.x),y=clampPct(s.y),w=Math.max(1,Math.min(100-x,clampPct(s.w,10))),h=Math.max(1,Math.min(100-y,clampPct(s.h,10)));sp.style.left=x+'%';sp.style.top=y+'%';sp.style.width=w+'%';sp.style.height=h+'%';$('badge').textContent=stepIndex+1;sp.hidden=false}
function renderStep(){const t=state.tutorials[currentTutorial];if(!t||!Array.isArray(t.steps)||!t.steps.length){showPublicEmpty('Este tutorial ainda não possui etapas.');return}stepIndex=Math.max(0,Math.min(stepIndex,t.steps.length-1));const s=t.steps[stepIndex];$('tutorialTitle').textContent=t.title||state.features[currentTutorial]?.label||'Tutorial';$('tutorialSub').textContent=`Guia ilustrado para ${condo()}`;$('counter').textContent=`PASSO ${stepIndex+1} DE ${t.steps.length}`;$('stepTitle').textContent=s.title||`Etapa ${stepIndex+1}`;$('stepText').textContent=s.text||'Siga a área destacada na imagem.';$('prevBtn').disabled=stepIndex===0;$('nextBtn').textContent=stepIndex===t.steps.length-1?'Concluir ✓':'Próximo →';if(!s.img){showPublicEmpty('Esta etapa ainda não possui um print. Adicione uma imagem pelo painel Administrador.');return}const img=$('stepImage');$('publicEmpty').hidden=true;$('spot').hidden=true;img.hidden=false;img.onload=()=>{requestAnimationFrame(()=>placePublicSpot(s))};img.onerror=()=>showPublicEmpty('A imagem desta etapa não foi encontrada. Edite esta etapa no painel Administrador.');img.src=s.img;if(img.complete&&img.naturalWidth)requestAnimationFrame(()=>placePublicSpot(s))}
function normalize(s){return s.toLowerCase().normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9 ]/g,' ')}
function ask(){const q=normalize($('question').value.trim());if(!q)return toast('Digite uma pergunta.');let best=null,score=0;for(const [k,t] of Object.entries(state.tutorials)){if(!enabled(k))continue;let s=0;for(const kw of t.keywords||[]){const n=normalize(kw);if(q.includes(n))s+=5;for(const w of n.split(' '))if(w.length>3&&q.includes(w))s++}for(const w of normalize(state.features[k]?.label||'').split(' '))if(w.length>3&&q.includes(w))s+=2;if(s>score){score=s;best=k}}if(best)startTutorial(best);else toast('Não encontrei esse passo a passo. Tente outra forma de perguntar.')}
$('askBtn').onclick=ask;$('question').onkeydown=e=>{if(e.key==='Enter')ask()};$('prevBtn').onclick=()=>{if(stepIndex>0){stepIndex--;renderStep()}};$('nextBtn').onclick=()=>{const t=state.tutorials[currentTutorial];if(!t)return;if(stepIndex<t.steps.length-1){stepIndex++;renderStep()}else toast('Passo a passo concluído!')};$('condoSelect').onchange=()=>{renderTopics();if(currentTutorial&&!enabled(currentTutorial)){currentTutorial=null;stepIndex=0;showPublicEmpty('Escolha um tutorial disponível para este condomínio.');$('tutorialTitle').textContent='Selecione um tutorial';$('tutorialSub').textContent='O guia será mostrado aqui.';$('counter').textContent='PASSO';$('stepTitle').textContent='Escolha um tutorial';$('stepText').textContent='A imagem, a área destacada e a instrução serão atualizadas em cada etapa.'}};
// admin auth and tabs
$('adminBtn').onclick=()=>{$('adminOverlay').classList.add('show');$('loginBox').hidden=false;$('adminPanel').hidden=true};$('loginBtn').onclick=()=>{if($('adminUser').value===state.admin.user&&$('adminPass').value===state.admin.pass){$('loginBox').hidden=true;$('adminPanel').hidden=false;renderCondoSelects();renderAdminFeatures();renderTutorialList()}else toast('Usuário ou senha inválidos.')};$('closeAdmin').onclick=()=>$('adminOverlay').classList.remove('show');document.querySelectorAll('.tab').forEach(b=>b.onclick=()=>{document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x===b));document.querySelectorAll('.admin-pane').forEach(p=>p.classList.remove('active'));$('pane-'+b.dataset.tab).classList.add('active');if(b.dataset.tab==='editor')renderTutorialList()});
function renderAdminFeatures(){const c=$('adminCondo').value;$('featureList').innerHTML=Object.entries(state.features).map(([k,f])=>`<label class="feature"><input type="checkbox" data-key="${esc(k)}" ${enabled(k,c)?'checked':''}><div><b>${esc(f.icon)} ${esc(f.label)}</b><small>${esc(f.desc)}</small></div></label>`).join('')}
$('adminCondo').onchange=renderAdminFeatures;$('saveFeatures').onclick=()=>{const c=$('adminCondo').value;document.querySelectorAll('#featureList input').forEach(ch=>state.condos[c][ch.dataset.key]=ch.checked);persist();$('condoSelect').value=c;renderTopics();toast('Opções salvas para '+c)};$('addCondo').onclick=()=>{const n=$('newCondo').value.trim();if(!n)return toast('Digite o nome do condomínio.');if(state.condos[n])return toast('Esse condomínio já existe.');state.condos[n]={};Object.keys(state.features).forEach(k=>state.condos[n][k]=true);persist();renderCondoSelects();$('adminCondo').value=n;renderAdminFeatures();$('newCondo').value='';toast('Condomínio adicionado.')};$('changeAdmin').onclick=()=>{const u=$('newAdminUser').value.trim(),p=$('newAdminPass').value;if(!u||p.length<4)return toast('Informe usuário e senha com pelo menos 4 caracteres.');state.admin={user:u,pass:p};persist();toast('Credencial alterada.')};$('resetData').onclick=()=>{if(confirm('Restaurar todos os dados de demonstração?')){state=clone(DEFAULT);persist();renderCondoSelects();renderTopics();renderAdminFeatures();renderTutorialList();toast('Dados restaurados.')}};
// tutorial editor
function renderTutorialList(){const keys=Object.keys(state.features);if(!editKey||!state.features[editKey])editKey=keys[0];$('tutorialList').innerHTML=keys.map(k=>`<button class="tutorial-item ${k===editKey?'active':''}" data-key="${esc(k)}"><b>${esc(state.features[k].icon)} ${esc(state.features[k].label)}</b><div class="hint" style="margin-top:3px">${state.tutorials[k]?.steps?.length||0} etapas</div></button>`).join('');document.querySelectorAll('.tutorial-item').forEach(b=>b.onclick=()=>{editKey=b.dataset.key;editStep=0;renderTutorialList();loadEditor()});loadEditor()}
function loadEditor(){const f=state.features[editKey],t=state.tutorials[editKey]||{title:'',keywords:[],steps:[]};if(!f)return;$('edLabel').value=f.label||'';$('edIcon').value=f.icon||'';$('edDesc').value=f.desc||'';$('edTitle').value=t.title||'';$('edKeywords').value=(t.keywords||[]).join(', ');renderStepList();loadStepForm()}
function renderStepList(){const t=state.tutorials[editKey];$('stepList').innerHTML=(t?.steps||[]).map((s,i)=>`<div class="step-row"><button class="step-pick ${i===editStep?'active':''}" data-i="${i}"><b>Passo ${i+1}</b><div class="hint" style="margin-top:2px">${esc(s.title||'Sem título')}</div></button></div>`).join('');document.querySelectorAll('.step-pick').forEach(b=>b.onclick=()=>{saveStepFields();editStep=+b.dataset.i;renderStepList();loadStepForm()})}
function loadStepForm(){const t=state.tutorials[editKey],s=t?.steps?.[editStep];const disabled=!s;['stTitle','stText','cx','cy','cw','ch','drawArea','clearArea','stepUp','stepDown','deleteStep','imageUpload'].forEach(id=>$(id).disabled=disabled);if(!s){$('stTitle').value='';$('stText').value='';$('markImage').hidden=true;$('markPlaceholder').hidden=false;$('editSpot').hidden=true;return}$('stTitle').value=s.title||'';$('stText').value=s.text||'';$('cx').value=num(s.x);$('cy').value=num(s.y);$('cw').value=num(s.w);$('ch').value=num(s.h);if(s.img){const mi=$('markImage');mi.onload=()=>requestAnimationFrame(renderEditSpot);mi.onerror=()=>{mi.hidden=true;$('markPlaceholder').hidden=false;$('markPlaceholder').textContent='Não foi possível carregar este print. Envie a imagem novamente.';$('editSpot').hidden=true};mi.src=s.img;mi.hidden=false;$('markPlaceholder').hidden=true;if(mi.complete&&mi.naturalWidth)requestAnimationFrame(renderEditSpot)}else{$('markImage').hidden=true;$('markPlaceholder').hidden=false;$('markPlaceholder').textContent='Adicione um print para esta etapa.';$('editSpot').hidden=true}}
function num(v){return typeof v==='number'?Math.round(v*10)/10:''}
function saveStepFields(){const s=state.tutorials[editKey]?.steps?.[editStep];if(!s)return;s.title=$('stTitle').value.trim();s.text=$('stText').value.trim();for(const [id,k] of [['cx','x'],['cy','y'],['cw','w'],['ch','h']]){const v=parseFloat($(id).value);if(Number.isFinite(v))s[k]=Math.max(0,Math.min(100,v))}}
function saveTutorialFields(){if(!editKey)return;const label=$('edLabel').value.trim();if(!label)return toast('Informe o nome do menu.');state.features[editKey].label=label;state.features[editKey].icon=$('edIcon').value.trim()||'📌';state.features[editKey].desc=$('edDesc').value.trim();state.tutorials[editKey].title=$('edTitle').value.trim()||('Como usar '+label+'?');state.tutorials[editKey].keywords=$('edKeywords').value.split(',').map(x=>x.trim()).filter(Boolean);saveStepFields();persist();renderTopics();renderAdminFeatures();renderTutorialList();toast('Tutorial salvo.')}
$('saveTutorial').onclick=saveTutorialFields;$('newTutorial').onclick=()=>{saveStepFields();let base='menu_'+Date.now();state.features[base]={icon:'📌',label:'Novo menu',desc:'Nova função do sistema.'};state.tutorials[base]={title:'Como usar este menu?',keywords:['novo menu'],steps:[]};for(const c of Object.keys(state.condos))state.condos[c][base]=(c===$('adminCondo').value);editKey=base;editStep=0;persist();renderTutorialList();renderAdminFeatures();toast('Novo menu criado. Agora monte o fluxo.')};$('deleteTutorial').onclick=()=>{if(!editKey||!confirm('Excluir este menu e todo o passo a passo?'))return;delete state.features[editKey];delete state.tutorials[editKey];for(const c of Object.keys(state.condos))delete state.condos[c][editKey];editKey=null;persist();renderTutorialList();renderAdminFeatures();renderTopics();toast('Menu excluído.')};
$('addStep').onclick=()=>{if(!editKey)return;saveStepFields();state.tutorials[editKey].steps.push({img:'',x:10,y:10,w:30,h:10,highlight:true,title:'Nova etapa',text:'Descreva o que o usuário deve fazer.'});editStep=state.tutorials[editKey].steps.length-1;renderStepList();loadStepForm()};$('deleteStep').onclick=()=>{const a=state.tutorials[editKey]?.steps;if(!a?.length||!confirm('Excluir esta etapa?'))return;a.splice(editStep,1);editStep=Math.max(0,Math.min(editStep,a.length-1));renderStepList();loadStepForm()};$('stepUp').onclick=()=>moveStep(-1);$('stepDown').onclick=()=>moveStep(1);function moveStep(d){saveStepFields();const a=state.tutorials[editKey]?.steps,j=editStep+d;if(!a||j<0||j>=a.length)return;[a[editStep],a[j]]=[a[j],a[editStep]];editStep=j;renderStepList();loadStepForm()}
// image upload with compression
$('imageUpload').onchange=e=>{const file=e.target.files[0];if(!file)return;const reader=new FileReader();reader.onload=ev=>{const img=new Image();img.onload=()=>{const max=820,scale=Math.min(1,max/img.width);const c=document.createElement('canvas');c.width=Math.round(img.width*scale);c.height=Math.round(img.height*scale);const ctx=c.getContext('2d');ctx.imageSmoothingEnabled=true;ctx.imageSmoothingQuality='high';ctx.drawImage(img,0,0,c.width,c.height);const data=c.toDataURL('image/jpeg',.72);const s=state.tutorials[editKey].steps[editStep];s.img=data;s.highlight=true;try{persist()}catch{}$('markImage').src=data;$('markImage').hidden=false;$('markPlaceholder').hidden=true;requestAnimationFrame(renderEditSpot);toast('Print adicionado. Agora marque a área do clique.')};img.src=ev.target.result};reader.readAsDataURL(file);e.target.value=''};
function renderEditSpot(){const s=state.tutorials[editKey]?.steps?.[editStep],sp=$('editSpot');if(!s||s.highlight===false||!s.img||$('markImage').hidden){sp.hidden=true;return}const x=clampPct(s.x),y=clampPct(s.y),w=Math.max(1,Math.min(100-x,clampPct(s.w,10))),h=Math.max(1,Math.min(100-y,clampPct(s.h,10)));sp.style.left=x+'%';sp.style.top=y+'%';sp.style.width=w+'%';sp.style.height=h+'%';sp.hidden=false}
for(const id of ['cx','cy','cw','ch'])$(id).oninput=()=>{saveStepFields();const s=state.tutorials[editKey]?.steps?.[editStep];if(s)s.highlight=true;renderEditSpot()};$('clearArea').onclick=()=>{const s=state.tutorials[editKey]?.steps?.[editStep];if(!s)return;s.highlight=false;$('editSpot').hidden=true;toast('Esta etapa ficará sem destaque.')};$('drawArea').onclick=()=>{const s=state.tutorials[editKey]?.steps?.[editStep];if(!s?.img)return toast('Primeiro adicione um print.');drawing=true;$('markStage').classList.add('drawing');toast('Arraste sobre o botão ou área que deseja destacar.')};
function stagePoint(ev){const r=$('markImage').getBoundingClientRect();return{x:Math.max(0,Math.min(100,(ev.clientX-r.left)/r.width*100)),y:Math.max(0,Math.min(100,(ev.clientY-r.top)/r.height*100))}}
$('markStage').addEventListener('pointerdown',e=>{if(!drawing||$('markImage').hidden)return;drawStart=stagePoint(e);e.currentTarget.setPointerCapture(e.pointerId)});$('markStage').addEventListener('pointermove',e=>{if(!drawing||!drawStart)return;const p=stagePoint(e),s=state.tutorials[editKey].steps[editStep];s.highlight=true;s.x=Math.min(drawStart.x,p.x);s.y=Math.min(drawStart.y,p.y);s.w=Math.abs(p.x-drawStart.x);s.h=Math.abs(p.y-drawStart.y);$('cx').value=num(s.x);$('cy').value=num(s.y);$('cw').value=num(s.w);$('ch').value=num(s.h);renderEditSpot()});$('markStage').addEventListener('pointerup',()=>{if(!drawing)return;drawing=false;drawStart=null;$('markStage').classList.remove('drawing');saveStepFields();persist();toast('Área marcada e salva. Ajuste novamente se precisar.')});
renderCondoSelects();renderTopics();showPublicEmpty('Escolha um tutorial para ver o passo a passo ilustrado.');
</script>
